# Copy this file to .env.local and fill in what you need. Everything is optional.

# Telegram alerts (run `npm run telegram:setup` after setting the token to find your chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Max disk space for downloaded photos, in GB (default 10). When full, the site shows photos from the source sites instead.
PHOTO_LIMIT_GB=10

# Minutes between quick checks for new listings (default 10)
SCRAPE_INTERVAL_MIN=10
